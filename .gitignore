# Local state — never commit. Set up before any config/storage code exists.
*.db
*.db-journal
*.db-wal
*.age
config.toml
.env
.env.local

# Build output
/bin/
/dist/
# Anchored to the repo root: an unanchored 'llmctl' would also ignore
# cmd/llmctl/, which is source.
/llmctl
/llmctl.exe

# Evaluation artifacts too large or too local to track
/eval/results/*.jsonl
!/eval/results/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
